#!/bin/sh
# pre-push — desde la Fase 2 no se sube nada a main sin 0 fallos en
# "npm run todo" y "npm run todo:visual" (PROMPT-MIGRACION-V5.md, seccion C).
#
# Se instala una vez con:   git config core.hooksPath scripts/hooks
# Solo actua al subir a main; las demas ramas suben sin comprobar.
# Lo visual va con --rapido (una pagina por tipo, unos 12 minutos). La pasada
# completa es "npm run todo:visual" (o con --todas) y se hace al cerrar cada fase.
# Netlify solo compila: quien impide subir algo roto es este fichero.

principal=""
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) principal=1 ;;
  esac
done
[ -z "$principal" ] && exit 0

echo ""
echo "pre-push: comprobaciones antes de subir a main (web Excursiones Valencia)"
echo ""
# En esta web (empresa nueva, 27-10-2026) no valen 'todo' ni 'todo:visual',
# que comparan con la web vieja de valenciaandgo: se comprueba lo mismo que
# compila Netlify y que no falta ningun fichero que pidan las paginas.
node scripts/fuentes-locales.mjs > /dev/null || { echo "NO SE SUBE: 'npm run fuentes' ha fallado."; exit 1; }
node scripts/hojas.mjs > /dev/null || { echo "NO SE SUBE: 'npm run hojas' ha fallado (mira informes/hojas.md)."; exit 1; }
npx astro build > /dev/null 2>&1 || { echo "NO SE SUBE: 'npm run build' ha fallado."; exit 1; }
node scripts/comprobar-recursos-nuevos.mjs | head -5
# el unico fichero que falta es un PDF que ya estaba roto en la web vieja
faltan=$(node scripts/comprobar-recursos-nuevos.mjs | grep -c '^  /' )
[ "$faltan" -le 1 ] || { echo ""; echo "NO SE SUBE: faltan ficheros que piden las paginas (arriba)."; exit 1; }
echo ""
echo "pre-push: todo bien, se sube."
exit 0

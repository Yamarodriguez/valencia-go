---
/**
 * Formulario de contacto. Reproduce el de la web actual (Contact Form 7):
 * mismos campos, mismo orden, mismo botón.
 *
 * Sustituye a los 251 formularios repetidos del WordPress por uno solo.
 * Envía por web3forms, que no necesita servidor. Mientras `formulario.accessKey`
 * esté vacío en site.json el botón no puede enviar, así que en su lugar se
 * ofrece el WhatsApp: una consulta nunca se pierde en silencio.
 */
import site from '../data/site.json';
const hayClave = Boolean(site.formulario.accessKey);
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappTexto)}`;
---

<div class="formulario">
  <form
    action={hayClave ? site.formulario.accion : undefined}
    method={hayClave ? 'POST' : undefined}
    onsubmit={hayClave ? undefined : 'return false'}
  >
    {hayClave && (
      <>
        <input type="hidden" name="access_key" value={site.formulario.accessKey} />
        <input type="hidden" name="subject" value="Consulta desde casascontenedores.es" />
        <input type="hidden" name="from_name" value={site.nombre} />
        <input type="hidden" name="redirect" value={site.dominio + site.formulario.gracias} />
        <input type="checkbox" name="botcheck" class="trampa" tabindex="-1" autocomplete="off" />
      </>
    )}

    <p class="campo">
      <label for="f-nombre">Tu nombre</label>
      <input id="f-nombre" name="nombre" type="text" required autocomplete="name" />
    </p>
    <p class="campo">
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" required autocomplete="email" />
    </p>
    <p class="campo">
      <label for="f-telefono">Teléfono</label>
      <input id="f-telefono" name="telefono" type="tel" required autocomplete="tel" />
    </p>
    <p class="campo">
      <label for="f-localidad">Provincia/Localidad</label>
      <input id="f-localidad" name="localidad" type="text" autocomplete="address-level2" />
    </p>
    <p class="campo">
      <label for="f-consulta">Asunto/consulta</label>
      <input id="f-consulta" name="consulta" type="text" />
    </p>
    <p class="consentimiento">
      <label>
        <input type="checkbox" name="consentimiento" required />
        {/* sin tildes, exactamente como lo escribio el formulario original */}
        He leido y acepto la <a href="/politica-privacidad/">politica de privacidad</a>
      </label>
    </p>

    {hayClave
      ? <p class="enviar"><button type="submit">ENVIAR</button></p>
      : <p class="enviar"><a class="boton-enviar" href={wa} target="_blank" rel="noopener">ESCRÍBENOS POR WHATSAPP</a></p>}
  </form>
</div>

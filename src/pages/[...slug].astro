---
/**
 * La ruta que pinta todas las paginas. Cada una es la suma de sus piezas,
 * capturadas de la web vieja y sin tocar: antes + cabecera + contenido + pie +
 * despues. Las rutas son las de WordPress (campo `ruta` del indice).
 *
 * Lo nuevo (fases 3 en adelante) se anade ALREDEDOR de las piezas, desde
 * src/data/, nunca dentro.
 */
import Base from '../layouts/Base.astro';
import { indice, leerPiezas } from '../utils/piezas.js';

export function getStaticPaths() {
  return indice().map((p) => ({
    params: { slug: p.ruta.replace(/^\/|\/$/g, '') || undefined },
    props: { pagina: p },
  }));
}

const { pagina } = Astro.props;
const z = leerPiezas(pagina.nombre);
---
<Base html={pagina.html} body={pagina.body} cabeza={z.cabeza}>
  <Fragment set:html={z.antes} /><Fragment set:html={z.cabecera} /><Fragment set:html={z.contenido} /><Fragment set:html={z.pie} /><Fragment set:html={z.despues} />
</Base>

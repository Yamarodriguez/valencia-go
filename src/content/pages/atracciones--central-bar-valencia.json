 "titulo": "Central Bar Valencia",
 "h1": "Central Bar Valencia",
 "tituloSeo": "Central Bar Valencia | Valencia & Go",
 "descripcion": "El Central Bar, en el Mercado Central de Valencia, es ideal para degustar tapas de autor mientras te sumerges en el bullicio del mercado.",
 "palabraClave": "Central Bar Valencia",
